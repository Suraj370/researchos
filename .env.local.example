# Postgres connection string. Matches docker-compose.yml's default credentials.
DATABASE_URL=postgresql://researchos:researchos@localhost:5432/researchos

# Exa API key (https://dashboard.exa.ai). Required for research to run.
# Never prefix this with NEXT_PUBLIC_ - it must never reach the browser.
EXA_API_KEY=

# OpenAI API key (https://platform.openai.com/api-keys). Required for the
# competitive-analysis phase (uses gpt-4.1-nano). Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
